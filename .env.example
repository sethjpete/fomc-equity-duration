# Copy to .env (git-ignored) and fill in. Never commit the real file.
# WRDS: the `wrds` package reads your password from ~/.pgpass after the first
# interactive login, so only the username is needed here.
WRDS_USERNAME=your_wrds_username

# FRED API key (free): https://fred.stlouisfed.org/docs/api/api_key.html
# Without it, DGS2/DGS10 come from Treasury.gov instead.
FRED_API_KEY=your_fred_api_key

# Optional: override where data lives (default: ./data)
# FOMCDUR_DATA_DIR=/path/to/shared/data
